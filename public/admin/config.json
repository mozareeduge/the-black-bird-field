{
  "$schema": "https://unpkg.com/@sveltia/cms@0.221.1/schema/sveltia-cms.json",
  "backend": {
    "name": "github",
    "repo": "mozareeduge/the-black-bird-field",
    "branch": "main",
    "auth_methods": [
      "token"
    ]
  },
  "site_url": "https://theblackbirdfield.com",
  "media_folder": "/public/assets",
  "public_folder": "/assets",
  "collections": [
    {
      "name": "site",
      "label": "Site and pages",
      "files": [
        {
          "name": "site_copy",
          "label": "Shared copy and pages",
          "file": "content/site.json",
          "format": "json",
          "fields": [
            {
              "name": "schema_version",
              "label": "Schema version",
              "widget": "hidden",
              "default": "1.0.0"
            },
            {
              "name": "site_title",
              "label": "Site title",
              "widget": "string"
            },
            {
              "name": "site_origin",
              "label": "Site address",
              "widget": "string",
              "type": "url",
              "readonly": true
            },
            {
              "name": "artistic_name",
              "label": "Artistic name",
              "widget": "string"
            },
            {
              "name": "formal_name",
              "label": "Formal name",
              "widget": "string"
            },
            {
              "name": "year",
              "label": "Year",
              "widget": "number",
              "min": 2000,
              "max": 2100
            },
            {
              "name": "github_profile",
              "label": "GitHub profile",
              "widget": "string",
              "type": "url"
            },
            {
              "name": "email",
              "label": "Email",
              "widget": "string",
              "type": "email"
            },
            {
              "name": "linkedin",
              "label": "Linkedin",
              "widget": "string",
              "type": "url"
            },
            {
              "name": "shared",
              "label": "Shared copy",
              "widget": "object",
              "fields": [
                {
                  "name": "deck",
                  "label": "Deck",
                  "widget": "text"
                },
                {
                  "name": "section_intro",
                  "label": "Section intro",
                  "widget": "text"
                },
                {
                  "name": "footer_identity",
                  "label": "Footer identity",
                  "widget": "text"
                },
                {
                  "name": "name_boundary",
                  "label": "Name boundary",
                  "widget": "string"
                },
                {
                  "name": "menu_name_boundary",
                  "label": "Menu name boundary",
                  "widget": "string"
                },
                {
                  "name": "about_strip",
                  "label": "About strip",
                  "widget": "text"
                }
              ]
            },
            {
              "name": "practice",
              "label": "Practice page",
              "widget": "object",
              "fields": [
                {
                  "name": "mast",
                  "label": "Mast",
                  "widget": "text"
                },
                {
                  "name": "intro",
                  "label": "Intro",
                  "widget": "list",
                  "field": {
                    "name": "value",
                    "label": "Text",
                    "widget": "text"
                  }
                },
                {
                  "name": "modules",
                  "label": "Modules",
                  "widget": "list",
                  "fields": [
                    {
                      "name": "id",
                      "label": "Id",
                      "widget": "string"
                    },
                    {
                      "name": "index",
                      "label": "Index",
                      "widget": "string"
                    },
                    {
                      "name": "title",
                      "label": "Title",
                      "widget": "string"
                    },
                    {
                      "name": "home_title",
                      "label": "Home title",
                      "widget": "string"
                    },
                    {
                      "name": "home_text",
                      "label": "Home text",
                      "widget": "string"
                    },
                    {
                      "name": "text",
                      "label": "Text",
                      "widget": "text"
                    },
                    {
                      "name": "image",
                      "label": "Image",
                      "widget": "string"
                    },
                    {
                      "name": "alt",
                      "label": "Image description",
                      "widget": "string"
                    },
                    {
                      "name": "caption",
                      "label": "Caption",
                      "widget": "string"
                    }
                  ],
                  "summary": "{{index}} ? {{title}}"
                },
                {
                  "name": "home_teaser",
                  "label": "Home practice teaser",
                  "widget": "object",
                  "fields": [
                    {
                      "name": "title",
                      "label": "Title",
                      "widget": "string"
                    },
                    {
                      "name": "text",
                      "label": "Text",
                      "widget": "text"
                    }
                  ]
                }
              ]
            },
            {
              "name": "about",
              "label": "About page",
              "widget": "object",
              "fields": [
                {
                  "name": "mast",
                  "label": "Mast",
                  "widget": "text"
                },
                {
                  "name": "paragraphs",
                  "label": "Paragraphs",
                  "widget": "list",
                  "field": {
                    "name": "value",
                    "label": "Text",
                    "widget": "text"
                  }
                },
                {
                  "name": "facts",
                  "label": "Facts",
                  "widget": "list",
                  "fields": [
                    {
                      "name": "term",
                      "label": "Fact label",
                      "widget": "string"
                    },
                    {
                      "name": "detail",
                      "label": "Fact detail",
                      "widget": "string"
                    }
                  ],
                  "summary": "{{term}}"
                }
              ]
            },
            {
              "name": "contact",
              "label": "Contact page",
              "widget": "object",
              "fields": [
                {
                  "name": "mast",
                  "label": "Mast",
                  "widget": "text"
                }
              ]
            },
            {
              "name": "metadata",
              "label": "Search descriptions",
              "widget": "object",
              "fields": [
                {
                  "name": "home",
                  "label": "Home",
                  "widget": "string"
                },
                {
                  "name": "works",
                  "label": "Works",
                  "widget": "string"
                },
                {
                  "name": "practice",
                  "label": "Practice page",
                  "widget": "string"
                },
                {
                  "name": "about",
                  "label": "About page",
                  "widget": "string"
                },
                {
                  "name": "contact",
                  "label": "Contact page",
                  "widget": "string"
                }
              ]
            },
            {
              "name": "documents",
              "label": "Documents",
              "widget": "object",
              "fields": [
                {
                  "name": "cv",
                  "label": "CV",
                  "widget": "object",
                  "fields": [
                    {
                      "name": "path",
                      "label": "Path",
                      "widget": "string"
                    },
                    {
                      "name": "label",
                      "label": "Label",
                      "widget": "string"
                    }
                  ]
                }
              ],
              "readonly": true
            }
          ]
        }
      ]
    },
    {
      "name": "works",
      "label": "Works",
      "label_singular": "Work",
      "folder": "content/works",
      "format": "json",
      "extension": "json",
      "identifier_field": "title",
      "summary": "{{order}} ? {{title}}",
      "preview_path": "/works/{{slug}}/",
      "create": false,
      "delete": false,
      "fields": [
        {
          "name": "schema_version",
          "label": "Schema version",
          "widget": "hidden",
          "default": "1.0.0"
        },
        {
          "name": "slug",
          "label": "Slug",
          "widget": "string",
          "pattern": [
            "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "Use lowercase letters, numbers and hyphens."
          ],
          "readonly": true
        },
        {
          "name": "asset_slug",
          "label": "Image folder",
          "widget": "string",
          "pattern": [
            "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "Use lowercase letters, numbers and hyphens."
          ],
          "readonly": true
        },
        {
          "name": "order",
          "label": "Order",
          "widget": "number",
          "min": 1
        },
        {
          "name": "title",
          "label": "Title",
          "widget": "string"
        },
        {
          "name": "title_parts",
          "label": "Title lines",
          "required": false,
          "widget": "list",
          "field": {
            "name": "value",
            "label": "Text",
            "widget": "string"
          }
        },
        {
          "name": "mode",
          "label": "Mode",
          "widget": "string"
        },
        {
          "name": "form",
          "label": "Form",
          "widget": "string"
        },
        {
          "name": "year",
          "label": "Year",
          "widget": "number",
          "min": 2000,
          "max": 2100
        },
        {
          "name": "summary",
          "label": "Summary",
          "widget": "text"
        },
        {
          "name": "responsibility",
          "label": "Responsibility",
          "widget": "string"
        },
        {
          "name": "meta_description",
          "label": "Search description",
          "widget": "text"
        },
        {
          "name": "live_url",
          "label": "Live work URL",
          "widget": "string",
          "type": "url"
        },
        {
          "name": "repository_url",
          "label": "Source repository URL",
          "widget": "string",
          "type": "url"
        },
        {
          "name": "poster_caption",
          "label": "Poster caption",
          "widget": "string"
        },
        {
          "name": "feature_caption",
          "label": "Feature caption",
          "widget": "string"
        },
        {
          "name": "feature_image",
          "label": "Featured view role",
          "widget": "string"
        },
        {
          "name": "hero_lead",
          "label": "Project lead",
          "widget": "text"
        },
        {
          "name": "prelude",
          "label": "Reading conditions",
          "widget": "object",
          "fields": [
            {
              "name": "label",
              "label": "Label",
              "widget": "string"
            },
            {
              "name": "items",
              "label": "Items",
              "widget": "list",
              "min": 3,
              "max": 3,
              "fields": [
                {
                  "name": "label",
                  "label": "Label",
                  "widget": "string"
                },
                {
                  "name": "title",
                  "label": "Title",
                  "widget": "string"
                },
                {
                  "name": "note",
                  "label": "Note",
                  "required": false,
                  "widget": "string"
                }
              ],
              "summary": "{{label}} ? {{title}}"
            }
          ]
        },
        {
          "name": "views",
          "label": "Selected views",
          "widget": "object",
          "fields": [
            {
              "name": "title",
              "label": "Title",
              "widget": "string"
            },
            {
              "name": "intro",
              "label": "Intro",
              "widget": "text"
            },
            {
              "name": "items",
              "label": "Items",
              "widget": "list",
              "min": 3,
              "max": 3,
              "fields": [
                {
                  "name": "number",
                  "label": "View number",
                  "widget": "string"
                },
                {
                  "name": "title",
                  "label": "Title",
                  "widget": "string"
                },
                {
                  "name": "text",
                  "label": "Text",
                  "widget": "string"
                },
                {
                  "name": "role",
                  "label": "Image role",
                  "widget": "string"
                },
                {
                  "name": "alt",
                  "label": "Image description",
                  "widget": "string"
                }
              ],
              "summary": "{{number}} ? {{title}}"
            }
          ]
        },
        {
          "name": "context",
          "label": "Context",
          "widget": "object",
          "fields": [
            {
              "name": "title",
              "label": "Title",
              "widget": "string"
            },
            {
              "name": "paragraphs",
              "label": "Paragraphs",
              "widget": "list",
              "min": 1,
              "field": {
                "name": "value",
                "label": "Text",
                "widget": "text"
              }
            },
            {
              "name": "coda",
              "label": "Coda",
              "required": false,
              "widget": "string"
            }
          ]
        },
        {
          "name": "identity",
          "label": "Edition and access",
          "widget": "object",
          "fields": [
            {
              "name": "edition",
              "label": "Edition",
              "widget": "string"
            },
            {
              "name": "language",
              "label": "Language",
              "widget": "string"
            },
            {
              "name": "encounter",
              "label": "Encounter",
              "widget": "string"
            }
          ]
        },
        {
          "name": "citation",
          "label": "Citation",
          "widget": "object",
          "fields": [
            {
              "name": "author",
              "label": "Author",
              "widget": "string"
            },
            {
              "name": "title",
              "label": "Title",
              "widget": "string"
            },
            {
              "name": "rest",
              "label": "Rest",
              "widget": "string"
            }
          ]
        },
        {
          "name": "motion",
          "label": "Motion media",
          "required": false,
          "widget": "object",
          "fields": [
            {
              "name": "enabled",
              "label": "Enabled",
              "widget": "boolean"
            },
            {
              "name": "home_preview",
              "label": "Motion on home preview",
              "widget": "boolean"
            },
            {
              "name": "project_hero",
              "label": "Motion on project hero",
              "widget": "boolean"
            },
            {
              "name": "desktop_file",
              "label": "Desktop file",
              "widget": "string",
              "readonly": true
            },
            {
              "name": "mobile_file",
              "label": "Mobile file",
              "widget": "string",
              "readonly": true
            },
            {
              "name": "fallback_role",
              "label": "Motion fallback image role",
              "widget": "string",
              "readonly": true
            },
            {
              "name": "source_roles",
              "label": "Motion source roles",
              "widget": "list",
              "field": {
                "name": "value",
                "label": "Text",
                "widget": "string"
              },
              "readonly": true
            },
            {
              "name": "verb",
              "label": "Verb",
              "widget": "string"
            },
            {
              "name": "duration_seconds",
              "label": "Duration in seconds",
              "widget": "number",
              "value_type": "float"
            },
            {
              "name": "provenance",
              "label": "Provenance",
              "widget": "text"
            }
          ]
        },
        {
          "name": "body_class",
          "label": "Body class",
          "required": false,
          "widget": "string",
          "readonly": true
        }
      ]
    }
  ]
}
